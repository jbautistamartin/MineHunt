{
  "name": "@minehunt/game-engine",
  "version": "0.9.0",
  "description": "Motor de juego de MineHunt: logica pura en TypeScript, sin Angular ni DOM",
  "license": "UNLICENSED",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "compilar": "tsc --build",
    "verificar-tipos": "tsc --noEmit -p tsconfig.spec.json",
    "probar": "vitest run",
    "probar:ver": "vitest",
    "limpiar": "tsc --build --clean"
  },
  "devDependencies": {
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  }
}
