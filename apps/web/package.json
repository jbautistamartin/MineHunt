{
  "name": "@minehunt/web",
  "version": "0.1.0",
  "scripts": {
    "arrancar": "ng serve",
    "compilar": "ng build",
    "probar": "ng test",
    "probar:ver": "ng test --watch",
    "verificar-tipos": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.spec.json",
    "ng": "ng",
    "recursos-android": "node herramientas/generar-recursos-android.mjs",
    "recursos-web": "node herramientas/generar-iconos-web.mjs",
    "sincronizar-android": "ng build && cap sync android",
    "abrir-android": "cap open android",
    "apk-android": "ng build && cap sync android && cd android && .\\gradlew.bat assembleDebug",
    "aab-android": "ng build && cap sync android && cd android && .\\gradlew.bat bundleRelease"
  },
  "private": true,
  "packageManager": "npm@11.17.0",
  "dependencies": {
    "@angular/common": "^22.1.0",
    "@angular/compiler": "^22.1.0",
    "@angular/core": "^22.1.0",
    "@angular/forms": "^22.1.0",
    "@angular/platform-browser": "^22.1.0",
    "@angular/router": "^22.1.0",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.1",
    "@capacitor/device": "^8.0.3",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/share": "^8.0.1",
    "@capacitor/splash-screen": "^8.0.2",
    "@minehunt/game-engine": "*",
    "@ngx-translate/core": "^18.0.0",
    "@ngx-translate/http-loader": "^18.0.0",
    "rxjs": "~7.8.0",
    "socket.io-client": "^4.8.3",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.1.6",
    "@angular/cli": "^22.1.6",
    "@angular/compiler-cli": "^22.1.0",
    "@capacitor/android": "^8.5.1",
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.1",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "vitest": "^4.0.8"
  },
  "description": "Cliente Angular de MineHunt (web y, via Capacitor, Android)"
}
