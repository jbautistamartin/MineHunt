{
  "name": "@minehunt/server",
  "version": "0.1.0",
  "description": "Servidor NestJS de MineHunt: autoridad del juego y salas multijugador",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "arrancar": "nest start",
    "arrancar:dev": "nest start --watch",
    "arrancar:prod": "node dist/main",
    "compilar": "nest build",
    "probar": "vitest run",
    "probar:ver": "vitest",
    "probar:e2e": "vitest run --config ./vitest.config.e2e.ts",
    "humo": "node scripts/humo.mjs",
    "probar:cobertura": "vitest run --coverage",
    "verificar-tipos": "tsc --noEmit -p tsconfig.json",
    "lint": "oxlint src/ test/",
    "formatear": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\""
  },
  "dependencies": {
    "@minehunt/game-engine": "*",
    "@nestjs/common": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/platform-express": "^12.0.1",
    "@nestjs/platform-socket.io": "^12.0.1",
    "@nestjs/websockets": "^12.0.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "socket.io": "^4.8.3"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/mau": "^0.2.6",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/supertest": "^7.0.0",
    "@vitest/coverage-v8": "^4.1.2",
    "oxlint": "^1.58.0",
    "prettier": "^3.4.2",
    "socket.io-client": "^4.8.3",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "typescript": "^6.0.2",
    "vitest": "^4.1.2"
  }
}
